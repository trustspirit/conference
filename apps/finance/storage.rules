rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function userDoc() {
      return request.auth != null
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data
        : null;
    }
    function systemRole() {
      let u = userDoc();
      return u == null ? null : u.systemRole;
    }
    function isStaff() {
      // Bankbook access: any authenticated user
      // (matches firestore /users read trust model — internal-tool trust).
      return request.auth != null;
    }

    match /receipts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functions만 쓰기
    }
    // Bank book images contain sensitive PII (account holder, signature) —
    // only the owner or staff (reviewers/admins) may read them.
    match /bankbook/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isStaff());
      allow write: if false;
    }
    match /vendor-bankbook/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isStaff());
      allow write: if false;
    }
    match /routemaps/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
