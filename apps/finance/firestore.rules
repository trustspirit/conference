rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userRole() {
      return request.auth != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return userRole() in ['admin', 'super_admin'];
    }

    function isStaff() {
      return request.auth != null && userRole() != 'user';
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isStaff());
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId
        || isAdmin();
      allow delete: if isAdmin();
    }
    match /requests/{requestId} {
      allow read: if request.auth != null
        && (
          resource.data.requestedBy.uid == request.auth.uid
          || isStaff()
        );
      allow create: if request.auth != null
        && request.resource.data.requestedBy.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.approvedBy == null
        && request.resource.data.approvalSignature == null
        && request.resource.data.reviewedBy == null
        // If this is a resubmission, the original must belong to the same requester.
        // Prevents attaching one's own resubmit to another user's rejected request.
        && (
          !('originalRequestId' in request.resource.data)
          || request.resource.data.originalRequestId == null
          || get(/databases/$(database)/documents/requests/$(request.resource.data.originalRequestId)).data.requestedBy.uid == request.auth.uid
        );
      allow update: if request.auth != null
        && (
          // --- Reviewer transitions (pending → reviewed | rejected) ---
          (
            resource.data.status == 'pending'
            && request.resource.data.status in ['reviewed', 'rejected']
            && request.auth.uid != resource.data.requestedBy.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason'])
            && (
              (userRole() == 'finance_ops' && resource.data.committee == 'operations')
              || userRole() in ['finance_prep', 'admin', 'super_admin']
            )
          )
          // --- Final approver transitions (reviewed → approved | rejected) ---
          // Rejection is allowed by any approver for their committee (no amount check)
          || (
            resource.data.status == 'reviewed'
            && request.resource.data.status == 'rejected'
            && request.auth.uid != resource.data.requestedBy.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt', 'approvalSignature', 'rejectionReason'])
            && (
              (userRole() == 'approver_ops' && resource.data.committee == 'operations')
              || (userRole() == 'approver_prep' && resource.data.committee == 'preparation')
              || (userRole() == 'session_director' && resource.data.committee == 'operations')
              || (userRole() == 'logistic_admin' && resource.data.committee == 'preparation')
              || userRole() in ['executive', 'admin', 'super_admin']
            )
          )
          // Approval by basic approvers: amount must be within project threshold
          || (
            resource.data.status == 'reviewed'
            && request.resource.data.status == 'approved'
            && request.auth.uid != resource.data.requestedBy.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt', 'approvalSignature', 'rejectionReason'])
            && (
              // Basic approvers: enforce amount threshold from project settings
              (
                userRole() in ['approver_ops', 'approver_prep']
                && (
                  (userRole() == 'approver_ops' && resource.data.committee == 'operations')
                  || (userRole() == 'approver_prep' && resource.data.committee == 'preparation')
                )
                && resource.data.totalAmount <= get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.directorApprovalThreshold
              )
              // Directors, executive, admins: no amount limit
              || (userRole() == 'session_director' && resource.data.committee == 'operations')
              || (userRole() == 'logistic_admin' && resource.data.committee == 'preparation')
              || userRole() in ['executive', 'admin', 'super_admin']
            )
          )
          // --- Settlement: approved → settled (finance_prep, admin) ---
          || (
            resource.data.status == 'approved'
            && request.resource.data.status == 'settled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'settlementId'])
            && userRole() in ['finance_prep', 'admin', 'super_admin']
          )
          // --- Force reject: approved → force_rejected (finance_prep, admin) ---
          || (
            resource.data.status == 'approved'
            && request.resource.data.status == 'force_rejected'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason', 'forceRejectedBy', 'forceRejectedAt'])
            && userRole() in ['finance_prep', 'admin', 'super_admin']
          )
          // --- Requester cancel: pending → cancelled (own request only) ---
          || (
            resource.data.requestedBy.uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
          // --- Super admin rollback: approved → reviewed (clears approval fields) ---
          || (
            resource.data.status == 'approved'
            && request.resource.data.status == 'reviewed'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'approvedBy', 'approvedAt', 'approvalSignature'])
            && request.resource.data.approvedBy == null
            && request.resource.data.approvedAt == null
            && request.resource.data.approvalSignature == null
            && userRole() == 'super_admin'
          )
          // --- Staff can tweak the per-receipt PDF display-size map ---
          // Lets reviewers/finance flag specific receipts as "large" for PDF export.
          // Only the `receiptDisplaySizes` field is writable here, so the immutable
          // receipt identity fields (storagePath, url, fileName) inside `receipts`
          // remain untouchable — closing the H-2 review finding.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptDisplaySizes'])
            && userRole() in [
              'finance_prep', 'finance_ops', 'admin', 'super_admin',
              'approver_ops', 'approver_prep', 'session_director',
              'logistic_admin', 'executive'
            ]
          )
          // --- Super admin cascade cleanup: clear originalRequestId only ---
          // Needed so the deleteRequest mutation can unlink resubmissions inside its
          // transaction. The rule cannot know which request is being deleted, so it
          // accepts any super_admin write that ONLY sets originalRequestId to null.
          // Risk is limited because super_admin is a highly trusted, Firestore-only role.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['originalRequestId'])
            && request.resource.data.originalRequestId == null
            && userRole() == 'super_admin'
          )
        );
      allow delete: if request.auth != null
        && userRole() == 'super_admin'
        && resource.data.status in ['pending', 'rejected', 'cancelled', 'force_rejected'];
    }
    // AI chatbot settings — server-only access via Admin SDK
    match /ai-settings/{docId} {
      allow read, write: if false;
    }
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && userRole() in ['admin', 'super_admin', 'finance_prep'];
    }
    match /settlements/{docId} {
      allow read: if request.auth != null
        && userRole() in ['admin', 'super_admin', 'executive', 'session_director', 'logistic_admin', 'finance_prep', 'approver_ops', 'approver_prep'];
      allow create: if request.auth != null
        && userRole() in ['admin', 'super_admin', 'finance_prep']
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['projectId', 'batchId', 'payee', 'committee', 'items', 'totalAmount', 'requestIds', 'createdBy', 'createdAt'])
        && request.resource.data.committee in ['operations', 'preparation']
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.requestIds is list
        && request.resource.data.requestIds.size() > 0
        && request.resource.data.batchId is string
        && request.resource.data.projectId is string;
      // Settlements are immutable after creation; only super_admin can correct or delete.
      allow update: if userRole() == 'super_admin';
      allow delete: if userRole() == 'super_admin';
    }
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && (
          isAdmin()
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.auth.uid in request.resource.data.memberUids
          )
        );
      allow create: if request.auth != null
        && isAdmin();
      allow delete: if request.auth != null
        && isAdmin();
    }
  }
}
