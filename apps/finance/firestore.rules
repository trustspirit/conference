rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Helpers ----
    function userDoc() {
      return request.auth != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function systemRole() {
      let u = userDoc();
      return u == null ? null : u.systemRole;
    }

    function isSuperAdmin() {
      return systemRole() == 'super_admin';
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    // Returns the effective ProjectRole for a uid in a project, or null.
    // super_admin is always 'admin' regardless of membership.
    function effectiveProjectRole(projectId, uid) {
      return isSuperAdmin()
        ? 'admin'
        : (
            'memberRoles' in projectDoc(projectId)
              ? projectDoc(projectId).memberRoles[uid]
              : null
          );
    }

    function callerProjectRole(projectId) {
      return effectiveProjectRole(projectId, request.auth.uid);
    }

    function hasProjectRole(projectId, allowed) {
      return callerProjectRole(projectId) in allowed;
    }

    function canManageOpsBudget(projectId) {
      return hasProjectRole(projectId,
        ['admin', 'finance_ops', 'approver_ops', 'session_director']);
    }

    function isProjectMember(projectId) {
      return request.auth != null
        && (
          callerProjectRole(projectId) != null
          || isSuperAdmin()
        );
    }

    function diffOnlyTouches(allowedKeys) {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(allowedKeys);
    }

    match /users/{userId} {
      // Read: own doc, or any authenticated user (member directory access).
      // Bank info is internal-tool trust; pre-G effective behavior was "any non-'user' role can read all".
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if (
          request.auth.uid == userId
          && !('systemRole' in request.resource.data.diff(resource.data).affectedKeys())
          && !('assignedProjectCount' in request.resource.data.diff(resource.data).affectedKeys())
        ) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
    match /requests/{requestId} {
      allow read: if request.auth != null
        && (
          resource.data.requestedBy.uid == request.auth.uid
          || callerProjectRole(resource.data.projectId) != null
        );
      allow create: if request.auth != null
        && request.resource.data.requestedBy.uid == request.auth.uid
        && callerProjectRole(request.resource.data.projectId) != null
        && request.resource.data.status == 'pending'
        && request.resource.data.approvedBy == null
        && request.resource.data.approvalSignature == null
        && request.resource.data.reviewedBy == null
        // If this is a resubmission, the original must belong to the same requester.
        // Prevents attaching one's own resubmit to another user's rejected request.
        && (
          !('originalRequestId' in request.resource.data)
          || request.resource.data.originalRequestId == null
          || get(/databases/$(database)/documents/requests/$(request.resource.data.originalRequestId)).data.requestedBy.uid == request.auth.uid
        );
      allow update: if request.auth != null
        && (
          // --- Reviewer transitions (pending → reviewed | rejected) ---
          (
            resource.data.status == 'pending'
            && request.resource.data.status in ['reviewed', 'rejected']
            && request.auth.uid != resource.data.requestedBy.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason'])
            && (
              (callerProjectRole(resource.data.projectId) == 'finance_ops' && resource.data.committee == 'operations')
              || callerProjectRole(resource.data.projectId) in ['finance_prep', 'admin']
            )
          )
          // --- Final approver transitions (reviewed → approved | rejected) ---
          // Rejection is allowed by any approver for their committee (no amount check)
          || (
            resource.data.status == 'reviewed'
            && request.resource.data.status == 'rejected'
            && request.auth.uid != resource.data.requestedBy.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt', 'approvalSignature', 'rejectionReason'])
            // Director-filed request: only executive/admin may reject
            && (
              !(
                resource.data.requestedBy.uid in projectDoc(resource.data.projectId).memberRoles
                && projectDoc(resource.data.projectId).memberRoles[resource.data.requestedBy.uid] in ['session_director', 'logistic_admin']
              )
              || callerProjectRole(resource.data.projectId) in ['executive', 'admin']
            )
            && (
              (callerProjectRole(resource.data.projectId) == 'approver_ops' && resource.data.committee == 'operations')
              || (callerProjectRole(resource.data.projectId) == 'approver_prep' && resource.data.committee == 'preparation')
              || (callerProjectRole(resource.data.projectId) == 'session_director' && resource.data.committee == 'operations')
              || (callerProjectRole(resource.data.projectId) == 'logistic_admin' && resource.data.committee == 'preparation')
              || callerProjectRole(resource.data.projectId) in ['executive', 'admin']
            )
          )
          // Approval by basic approvers: amount must be within project threshold
          || (
            resource.data.status == 'reviewed'
            && request.resource.data.status == 'approved'
            && request.auth.uid != resource.data.requestedBy.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt', 'approvalSignature', 'rejectionReason'])
            // Director-filed request: only executive/admin may approve
            && (
              !(
                resource.data.requestedBy.uid in projectDoc(resource.data.projectId).memberRoles
                && projectDoc(resource.data.projectId).memberRoles[resource.data.requestedBy.uid] in ['session_director', 'logistic_admin']
              )
              || callerProjectRole(resource.data.projectId) in ['executive', 'admin']
            )
            && (
              // Basic approvers: enforce amount threshold from project settings
              (
                callerProjectRole(resource.data.projectId) in ['approver_ops', 'approver_prep']
                && (
                  (callerProjectRole(resource.data.projectId) == 'approver_ops' && resource.data.committee == 'operations')
                  || (callerProjectRole(resource.data.projectId) == 'approver_prep' && resource.data.committee == 'preparation')
                )
                && resource.data.totalAmount <= projectDoc(resource.data.projectId).directorApprovalThreshold
              )
              // Directors, executive, admins: no amount limit
              || (callerProjectRole(resource.data.projectId) == 'session_director' && resource.data.committee == 'operations')
              || (callerProjectRole(resource.data.projectId) == 'logistic_admin' && resource.data.committee == 'preparation')
              || callerProjectRole(resource.data.projectId) in ['executive', 'admin']
            )
          )
          // --- Settlement: approved → settled (finance_prep, admin) ---
          || (
            resource.data.status == 'approved'
            && request.resource.data.status == 'settled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'settlementId'])
            && callerProjectRole(resource.data.projectId) in ['finance_prep', 'admin']
          )
          // --- Force reject: approved → force_rejected (finance_prep, admin) ---
          || (
            resource.data.status == 'approved'
            && request.resource.data.status == 'force_rejected'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason', 'forceRejectedBy', 'forceRejectedAt'])
            && callerProjectRole(resource.data.projectId) in ['finance_prep', 'admin']
          )
          // --- Requester cancel: pending → cancelled (own request only) ---
          || (
            resource.data.requestedBy.uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
          // --- Super admin rollback: approved → reviewed (clears approval fields) ---
          || (
            resource.data.status == 'approved'
            && request.resource.data.status == 'reviewed'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'approvedBy', 'approvedAt', 'approvalSignature'])
            && request.resource.data.approvedBy == null
            && request.resource.data.approvedAt == null
            && request.resource.data.approvalSignature == null
            && isSuperAdmin()
          )
          // --- Super admin settlement revert: settled → approved (clears settlementId) ---
          // Paired with settlement doc deletion in useRevertSettlementBatch.
          || (
            resource.data.status == 'settled'
            && request.resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'settlementId'])
            && !('settlementId' in request.resource.data)
            && isSuperAdmin()
          )
          // --- Staff can tweak the per-receipt PDF display-size map ---
          // Lets reviewers/finance flag specific receipts as "large" for PDF export.
          // Only the `receiptDisplaySizes` field is writable here, so the immutable
          // receipt identity fields (storagePath, url, fileName) inside `receipts`
          // remain untouchable — closing the H-2 review finding.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptDisplaySizes'])
            && callerProjectRole(resource.data.projectId) in [
              'finance_prep', 'finance_ops', 'admin',
              'approver_ops', 'approver_prep', 'session_director',
              'logistic_admin', 'executive'
            ]
          )
          // --- Super admin cascade cleanup: clear originalRequestId only ---
          // Needed so the deleteRequest mutation can unlink resubmissions inside its
          // transaction. The rule cannot know which request is being deleted, so it
          // accepts any super_admin write that ONLY sets originalRequestId to null.
          // Risk is limited because super_admin is a highly trusted, Firestore-only role.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['originalRequestId'])
            && request.resource.data.originalRequestId == null
            && isSuperAdmin()
          )
        );
      allow delete: if request.auth != null
        && isSuperAdmin()
        && resource.data.status in ['pending', 'rejected', 'cancelled', 'force_rejected'];
    }
    // AI chatbot settings — server-only access via Admin SDK
    match /ai-settings/{docId} {
      allow read, write: if false;
    }
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && systemRole() in ['admin', 'super_admin'];
    }
    match /settlements/{docId} {
      allow read: if request.auth != null
        && hasProjectRole(resource.data.projectId, ['admin', 'finance_prep', 'executive', 'session_director', 'logistic_admin', 'approver_ops', 'approver_prep']);
      allow create: if request.auth != null
        && hasProjectRole(request.resource.data.projectId, ['admin', 'finance_prep'])
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['projectId', 'batchId', 'payee', 'committee', 'items', 'totalAmount', 'requestIds', 'createdBy', 'createdAt'])
        && request.resource.data.committee in ['operations', 'preparation']
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.requestIds is list
        && request.resource.data.requestIds.size() > 0
        && request.resource.data.batchId is string
        && request.resource.data.projectId is string;
      // Settlements are immutable after creation; only super_admin can correct or delete.
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && (
          effectiveProjectRole(projectId, request.auth.uid) == 'admin'
          || isSuperAdmin()
          || (canManageOpsBudget(projectId) && diffOnlyTouches(['opsBudget']))
        );
      allow create: if request.auth != null && systemRole() in ['admin', 'super_admin'];
      allow delete: if request.auth != null && systemRole() in ['admin', 'super_admin'];

      match /opsBudgetInclusions/{inclusionId} {
        allow read:   if isProjectMember(projectId);
        allow create: if canManageOpsBudget(projectId)
          && inclusionId == request.resource.data.requestId
                            + '__'
                            + string(request.resource.data.itemIndex)
          && request.resource.data.keys().hasAll(
               ['categoryId','requestId','itemIndex','snapshot','addedBy','addedAt'])
          && request.resource.data.requestId is string
          && request.resource.data.itemIndex is int
          && request.resource.data.itemIndex >= 0
          && request.resource.data.categoryId is string
          && exists(/databases/$(database)/documents/requests/$(request.resource.data.requestId))
          && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.projectId == projectId
          && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.committee == 'operations'
          && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.status in ['approved', 'settled'];
        allow delete: if canManageOpsBudget(projectId);
        allow update: if false;
      }
    }
  }
}
